# USA CARS — variables d’environnement (documentation ; aucune valeur réelle ici).
#
# DÉVELOPPEMENT : ne copiez PAS les clés de production dans .env.local.
#   pnpm db:start   # démarre Supabase local (Docker requis)
#   pnpm db:env     # écrit .env.local avec les clés LOCALES générées par la CLI
#
# PRODUCTION : les valeurs du projet hzgkhtaefpbqztwagwph sont saisies uniquement dans les
# variables d’environnement de l’hébergeur (Cloudflare Workers, voir docs/18) et, si besoin, dans les secrets GitHub Actions.

# Environnement applicatif : local | production.
# Hors « production », l’application refuse de démarrer si l’URL Supabase pointe vers la production.
NEXT_PUBLIC_APP_ENV=local

# Supabase — URL de l’API et clé publique (anon / publishable), soumise à la RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — clé service_role (secret / contourne la RLS). Code serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l’application (liens dans les e-mails, redirections d’authentification).
APP_URL=http://localhost:3000

# Compte administrateur initial (phase 1, script idempotent d’invitation).
ADMIN_EMAIL=

# Notifications : simulated (journalise sans envoyer) jusqu’à la phase 4 ; live ensuite.
NOTIFICATIONS_MODE=simulated
