{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Environnement de FORMATION (decision P6-2) : copie de l'application pointant vers un projet
  // Supabase distinct (guhihvwkjefpafmskqsc), donnees fictives uniquement, jamais la production.
  "name": "usa-cars-formation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // NEXT_PUBLIC_APP_ENV = local : l'URL Supabase n'est pas la production, le garde-fou anti-prod
  // (lib/env.ts) reste actif. Les cles anon et service_role sont saisies dans Cloudflare
  // (variable de build + secrets d'execution), jamais dans le depot.
  "vars": {
    "NEXT_PUBLIC_APP_ENV": "local",
    "NEXT_PUBLIC_SUPABASE_URL": "https://guhihvwkjefpafmskqsc.supabase.co",
    "APP_URL": "https://usa-cars-formation.usacarsusasen.workers.dev",
    "ADMIN_EMAIL": "abdou.ndiaye@icloud.com",
    "NOTIFICATIONS_MODE": "simulated",
  },
}
