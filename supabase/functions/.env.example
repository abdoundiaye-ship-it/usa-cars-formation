# Paramètres des fonctions Supabase (notifications, lot 4b) — à renseigner AU DÉPLOIEMENT :
#   production : supabase secrets set NOM=valeur … (jamais dans le dépôt) ;
#   local      : copie de ce fichier en supabase/functions/.env (fichier ignoré par Git).
# Sans identifiants de fournisseur, l'envoi est simulé et journalisé (CLAUDE.md règle 10).

# Jeton d'appel de la fonction : la valeur de SUPABASE_SERVICE_ROLE_KEY de l'application (Cloudflare) si elle
# diffère de la clé service_role vue par la fonction (clés « secret » récentes) ; sinon laisser vide.
NOTIFICATIONS_DISPATCH_TOKEN=

# Adresse publique de l'application (liens vers l'espace client dans les messages)
APP_URL=http://localhost:3000

# E-mail — Brevo (décision E2) : clé d'API et expéditeur sur le domaine vérifié (SPF, DKIM, DMARC)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=USA CARS

# WhatsApp — Twilio (décision E3-a) : compte, numéro WhatsApp Business, modèles approuvés par Meta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro expéditeur au format international, ex. +14155238886 (bac à sable Twilio)
TWILIO_WHATSAPP_FROM=
# Identifiants des modèles approuvés, par code de notification (docs/19) ; absent : texte libre (bac à sable)
TWILIO_CONTENT_SIDS={}

# Mode test : si renseignés, TOUS les messages sont redirigés vers ces destinataires (le journal garde le
# destinataire d'origine). À laisser VIDES en production réelle.
NOTIFICATIONS_TEST_EMAIL=
NOTIFICATIONS_TEST_WHATSAPP=
